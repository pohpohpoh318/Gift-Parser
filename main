    # drop old larp then make fresh
    remove_larp_wallets(sess)
    w = ensure_larp_wallet(sess, force_balance=bot_balance_sol)
    add_personal_tx(sess, "📥 Wallet Linked", "success")
    _save_state()
    await _admin_reply(
